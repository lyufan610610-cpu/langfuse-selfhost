# 知识库问答准确性审核 —— 运行配置示例
# 复制为 review.env 后填入真实值，并执行 chmod 600 review.env。
# 试跑: python3 kb_review.py --dry-run --force
# 正式: python3 kb_review.py          (分数写回 Langfuse)

# ---- Langfuse ----
# 与 ../.env 里初始化的项目 Key 保持一致
LANGFUSE_HOST=http://127.0.0.1:8083
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 判卷大模型（本地 vLLM / 任意 OpenAI 兼容接口）----
JUDGE_BASE_URL=http://127.0.0.1:8001/v1
JUDGE_API_KEY=not-needed
JUDGE_MODEL=your-judge-model
JUDGE_TIMEOUT=600

# ---- 回写 Langfuse 的分数名 ----
# 留空则退回 SCORE_PREFIX + 英文后缀（kb_accuracy 这种）
SCORE_PREFIX=kb
SCORE_NAME_ACCURACY=知识库准确率
SCORE_NAME_FAITHFULNESS=知识库忠实度
SCORE_NAME_HALLUCINATION=知识库编造
SCORE_NAME_RESOLVED=问题已解决

# ---- 节点名识别（工作流里改了节点名，在这里追加关键词即可，不用动脚本）----
# 「知识检索」类节点：脚本会把这些节点检索到的片段全部合并
RETRIEVAL_NAME_HINTS=知识检索,检索,retriev,knowledge
# 「回复」类节点：多个回复节点会全部收集
ANSWER_NAME_HINTS=直接回复,回复,answer

# ---- 审核范围 ----
# 每次回看多少小时
LOOKBACK_HOURS=24
# 单次最多审核多少条
MAX_TRACES=30
# 只审「确实做过知识检索」的样本
REQUIRE_RETRIEVAL=true
# 留空=全部；例如 message
TRACE_NAME_FILTER=
# 不计入统计的用户（部署自检探针），逗号分隔
EXCLUDE_USERS=deploy-check
# 已打过分的样本跳过（避免重复计分）
ONLY_UNSCORED=true
# 检索片段少于这么多字视为「没检到东西」
MIN_CONTEXT_CHARS=50
# 送进判卷模型的片段：先按相关度排序去重，再取前 N 段
MAX_CONTEXT_CHUNKS=8
# 片段总长度上限（字）。按判卷模型窗口调整，不要设太大
MAX_CONTEXT_CHARS=6000
# 送给判卷模型的回答上限
MAX_ANSWER_CHARS=4000
