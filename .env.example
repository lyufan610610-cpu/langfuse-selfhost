# ============================================================
# Langfuse v4 环境变量示例
# 复制为 .env 后填入真实值，并执行 chmod 600 .env。
# 重要：改完这个文件必须 `docker compose down && docker compose up -d`，
#       只 `docker compose restart` 不会重读 .env。
# ============================================================

# ---------- 对外地址 ----------
# 浏览器打开 Langfuse 的地址，也是登录回调地址。改这里之后必须 down + up。
NEXTAUTH_URL=http://localhost:8083

# ---------- 三个核心密钥 ----------
# 用 `openssl rand -hex 32` 生成。装完之后不要再改：
# 改了库里已加密的凭据就解不开了。
NEXTAUTH_SECRET=change-me-openssl-rand-hex-32
SALT=change-me-openssl-rand-hex-16
ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/postgres

# ---------- ClickHouse ----------
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change-me

# ---------- Redis ----------
REDIS_AUTH=change-me

# ---------- MinIO（对象存储） ----------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
# 下面 4 行必须和上面 MinIO 的账号密码一致，否则 trace 大字段和图片会传不进去
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=change-me
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=change-me
# 浏览器里看 trace 中的图片时，拿这个地址去 MinIO 取
# （宿主 9090 映射到 minio 容器的 9000）
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9090

# ---------- 首次启动自动建组织 / 项目 / 账号 ----------
# 只在「空库第一次启动」时生效。库已经建好之后再改这里没有任何效果，
# 除非 docker compose down -v 把库删掉重来。
LANGFUSE_INIT_ORG_ID=example-org
LANGFUSE_INIT_ORG_NAME=ExampleOrg
LANGFUSE_INIT_PROJECT_ID=example-project
LANGFUSE_INIT_PROJECT_NAME=example-project
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=change-me

# ---------- 网页端 LLM 评估器能连的地址 ----------
# 不配这两行，网页里的评估器会拒绝连本地模型。
# 按你的实际网段填写，例如 192.168.0.0/16 或 10.0.0.0/8。
LANGFUSE_LLM_CONNECTION_WHITELISTED_IP_SEGMENTS=127.0.0.0/8
LANGFUSE_LLM_CONNECTION_WHITELISTED_IPS=127.0.0.1

# ---------- 杂项 ----------
# 内网机器，关掉遥测
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

LANGFUSE_MIGRATION_V4_WRITE_MODE=dual

# ---- 新用户自助注册自动加入现有组织/项目（没配 SMTP 时靠这个加人）----
LANGFUSE_DEFAULT_ORG_ID=example-org
LANGFUSE_DEFAULT_ORG_ROLE=MEMBER
LANGFUSE_DEFAULT_PROJECT_ID=example-project
LANGFUSE_DEFAULT_PROJECT_ROLE=MEMBER
